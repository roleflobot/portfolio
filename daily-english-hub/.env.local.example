# 이 파일을 복사해 .env.local로 저장하고 실제 값을 채우세요.
# .env.local은 .gitignore에 포함되어 있어 커밋되지 않습니다.

GEMINI_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: separately deployed Gemini Live voice lab URL.
NEXT_PUBLIC_VOICE_LAB_URL=
# Server-only: shared HMAC secret and SHA-256 hash of the Section 6 access code.
VOICE_LAB_SHARED_SECRET=
VOICE_LAB_ACCESS_CODE_HASH=
