              "name": "generationConfig",
              "value": "={{ { temperature: 0.1, responseMimeType: \"application/json\", responseSchema: { type: \"object\", properties: { category: {type:\"string\", enum:[\"결제\",\"계정\",\"상품\",\"배송\",\"기타\"]}, sentiment: {type:\"string\", enum:[\"긍정\",\"중립\",\"부정\"]}, urgency: {type:\"string\", enum:[\"상\",\"중\",\"하\"]}, summary: {type:\"string\"}, needs_review: {type:\"boolean\"} }, required: [\"category\",\"sentiment\",\"urgency\",\"summary\",\"needs_review\"] } } }}"
            }
          ]
