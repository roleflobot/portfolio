    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "systemInstruction",
              "value": "={{ { parts: [{ text: \"당신은 쇼핑몰 고객 VOC 분류기다. 입력된 고객 문의를 분석하여 반드시 유효한 JSON 객체 하나만 출력하라. 마크다운, 코드블록, 설명 문장, 인사말을 출력하지 마라. 출력 필드는 category(결제|계정|상품|배송|기타), sentiment(긍정|중립|부정), urgency(상|중|하), summary(80자 이하의 한국어 요약), needs_review(boolean)이다. category 판단 기준: 결제는 결제 오류, 중복 결제, 청구, 환불, 금액 문제. 계정은 로그인, 가입, 비밀번호, 인증, 회원 정보. 상품은 품질, 파손, 구성품, 재고, 상품 설명. 배송은 출고, 배송 지연, 오배송, 미배송, 수령. 기타는 위 네 범주에 명확히 속하지 않는 문의. urgency 판단 기준: 상은 서비스 사용 불가, 금전적 피해, 법적 대응 또는 언론 제보 언급, 명시적 환불 요구. 중은 불편하지만 사용 가능, 문의, 개선 요청. 하는 단순 질문, 칭찬, 정보 확인. needs_review는 무조건 false로 출력하라. 이 필드는 별도의 검증 시스템이 관리하는 것이지, 문의가 심각하거나 복잡하다고 독자적으로 판단하여 true로 바꿀 수 없다. 고객이 폼에서 선택한 문의유형은 참고만 하고, 실제 문의내용을 기준으로 category를 독립적으로 판단하라.\" }] } }}"
            },
            {
              "name": "contents",
              "value": "={{ [{ parts: [{ text: '고객 선택 문의유형: ' + $('02_Normalize_Input').item.json.inquiry_type + ' / 물품 번호: ' + $('02_Normalize_Input').item.json.product_number + ' / 문의내용: ' + $('02_Normalize_Input').item.json.inquiry_text }] }] }}"
            },
