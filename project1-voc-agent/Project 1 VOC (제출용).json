    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const upstream = $('02_Normalize_Input').item.json;\n\nconst allowedCategory = [\"결제\", \"계정\", \"상품\", \"배송\", \"기타\"];\nconst allowedSentiment = [\"긍정\", \"중립\", \"부정\"];\nconst allowedUrgency = [\"상\", \"중\", \"하\"];\n\nconst errors = [];\nlet parsed = {};\n\nlet rawText;\ntry {\n  rawText = $json.candidates[0].content.parts[0].text;\n} catch (e) {\n  rawText = undefined;\n}\n\nif (rawText === undefined) {\n  errors.push(\"LLM_CALL_FAILED_OR_MALFORMED_RESPONSE\");\n} else {\n  try {\n    parsed = typeof rawText === \"string\" ? JSON.parse(rawText) : rawText;\n  } catch (error) {\n    parsed = {};\n    errors.push(\"JSON_PARSE_ERROR\");\n  }\n}\n\nif (!parsed || Array.isArray(parsed) || typeof parsed !== \"object\") {\n  parsed = {};\n  errors.push(\"NOT_AN_OBJECT\");\n}\n\nif (!allowedCategory.includes(parsed.category)) errors.push(\"INVALID_CATEGORY\");\nif (!allowedSentiment.includes(parsed.sentiment)) errors.push(\"INVALID_SENTIMENT\");\nif (!allowedUrgency.includes(parsed.urgency)) errors.push(\"INVALID_URGENCY\");\nif (typeof parsed.summary !== \"string\" || parsed.summary.trim() === \"\") errors.push(\"INVALID_SUMMARY\");\nif (typeof parsed.summary === \"string\" && parsed.summary.length > 80) errors.push(\"SUMMARY_TOO_LONG\");\nif (typeof parsed.needs_review !== \"boolean\") errors.push(\"INVALID_NEEDS_REVIEW\");\n\nconst failed = errors.length > 0;\n\nreturn {\n  json: {\n    timestamp: upstream.timestamp,\n    inquiry_type: upstream.inquiry_type,\n    inquiry_text: upstream.inquiry_text,\n    email: upstream.email,\n    product_number: upstream.product_number,\n    dedupe_key: upstream.dedupe_key,\n    category: failed ? \"기타\" : parsed.category,\n    sentiment: failed ? \"중립\" : parsed.sentiment,\n    urgency: failed ? \"중\" : parsed.urgency,\n    summary: failed ? \"자동 분류 검증 실패 — 원문 확인 필요\" : parsed.summary.trim(),\n    needs_review: failed ? true : parsed.needs_review,\n    validation_error: errors.join(\", \")\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1600,
        -1712
      ],
      "id": "1262685a-5a78-43bd-9d81-4ea9c0989291",
      "name": "07_Parse_Validate_JSON"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $json;\n\nconst ymd = $now.toFormat('yyyyMMdd');\nconst processedAt = $now.toFormat('yyyy-MM-dd HH:mm:ss');\nconst suffix = String($execution.id ?? $now.toMillis()).slice(-6);\nconst ticketId = `VOC-${ymd}-${suffix}`;\n\nconst inquiryText = String(item.inquiry_text ?? \"\");\nconst discordPreview = inquiryText.length > 200 ? inquiryText.slice(0, 197) + \"...\" : inquiryText;\n\nreturn {\n  json: {\n    ...item,\n    ticket_id: ticketId,\n    processed_at: processedAt,\n    discord_preview: discordPreview\n  }\n};"
      },
